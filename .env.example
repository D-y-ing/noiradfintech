# =========================
# Noir / Stellar Testnet
# =========================
# Agent secret key (server-only, funds its own fees ~2.3 XLM first tap)
AGENT_SECRET=

# Card owner secret key (used to register device, set policy, fund escrow)
OWNER_SECRET=

# Creator/merchant secret key (claims payments)
CREATOR_SECRET=

# Campaign card UID (any string, will be SHA-256 hashed to deviceHash)
CARD_UID=velo-noir-campaign-2026

# =========================
# Velo (Testnet)
# =========================
# Get from velo-build.dev dashboard → Project → API Keys
VELO_API_KEY=

# Webhook secret from Velo dashboard
VELO_WEBHOOK_SECRET=

# Public URL of your deployed server (for Velo webhook URL + success/cancel URLs)
PUBLIC_API_URL=https://your-server.onrender.com

# =========================
# LLM (for agent decisions)
# =========================
# OpenAI / Anthropic / other API key
LLM_API_KEY=

# Optional: model override (defaults to gpt-4o-mini or claude-3-5-haiku)
LLM_MODEL=

# =========================
# Frontend
# =========================
# Public API URL (same as PUBLIC_API_URL)
VITE_API_URL=https://your-server.onrender.com