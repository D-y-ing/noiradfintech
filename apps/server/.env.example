# Server-specific env (also reads from root .env)
# Copy root .env to here or set these directly

# Noir / Stellar
AGENT_SECRET=
OWNER_SECRET=
CREATOR_SECRET=
DEVICE_HASH=
CARD_UID=velo-noir-campaign-2026

# Velo
VELO_API_KEY=
VELO_WEBHOOK_SECRET=
PUBLIC_API_URL=https://your-server.onrender.com
FRONTEND_URL=https://your-app.vercel.app

# LLM
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Server
PORT=3001
NODE_ENV=development
